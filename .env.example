# Venice Inference Organizer
# Copy to .env and fill in local values. Never commit secrets.

# Inference key used to refresh the public catalog (GET /models).
VENICE_API_KEY=

# Admin key used only when Key Master is not installed and VIO must
# list or update keys directly against Venice. Optional.
VENICE_ADMIN_KEY=

VENICE_BASE_URL=https://api.venice.ai/api/v1

# VIO HTTP + dashboard
VIO_HOST=127.0.0.1
VIO_PORT=8787
VIO_DATA_DIR=./data
VIO_SERVICE_TOKEN=change-me
VIO_DEFAULT_LANE=medium
VIO_REFRESH_SECONDS=3600

# Optional Venice Key Manager sidecar on this machine.
# Leave URL as localhost. Token is the Key Manager dashboard access token.
VIO_KEYMASTER_URL=http://127.0.0.1:8660
VIO_KEYMASTER_TOKEN=
VIO_KEYMASTER_TIMEOUT=2.5
